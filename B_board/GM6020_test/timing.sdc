# Board oscillator driving I_sys_clk is 50 MHz.
create_clock -name I_sys_clk_50m -period 20.000 -waveform {0.000 10.000} [get_ports {I_sys_clk}]

# Derive the 25 MHz clock generated by u_pll and all other clock-buffer outputs.
derive_clocks

# UART RX is asynchronous and enters the two-stage synchronizer.
set_false_path -from [get_ports {I_uart_rx}]

# Independent sensor UART RX enters the TOF receiver's two-stage synchronizer.
set_false_path -from [get_ports {I_tof_uart_rx}]

# Wheel encoder phases are asynchronous and enter per-wheel two-stage synchronizers.
set_false_path -from [get_ports {E1A E1B E2A E2B E3A E3B E4A E4B}]

# Independent 1 Gbit/s RGMII receive clock from the PHY.
create_clock -name eth_rx_clk -period 8.000 -waveform {0.000 4.000} [get_ports {I_eth_rx_clk}]
set_clock_groups -asynchronous \
    -group [get_clocks {eth_rx_clk}] \
    -group [get_clocks {I_sys_clk_50m u_ethernet_rx/u_clk/u_pll/u_PH1P_PHY_PLL.clkc[2]}]

# The Anlogic CAN IP transfers data internally between its application
# (sys_clk) and CAN-core (can_clk) domains.  Its CDC logic must not be timed
# as a direct synchronous 50 MHz <-> 25 MHz path.
set_clock_groups -asynchronous \
    -group [get_clocks {I_sys_clk_50m}] \
    -group [get_clocks {u_pll/ph1p_phy_pll_wrapper_f2a3202c24aa_Inst/u_PH1P_PHY_PLL.clkc[0]}]
